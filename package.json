{
  "name": "obrazownik",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.x"
  },
  "scripts": {
    "dev": "concurrently --kill-others 'tsx watch src/server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/index.js",
    "doctor": "tsx scripts/doctor.ts",
    "check": "tsc --noEmit && eslint . && vitest run && tsx scripts/validate-content.ts && node scripts/check-context.mjs && node scripts/repo-check.mjs",
    "test": "vitest run",
    "test:e2e": "node scripts/e2e.mjs",
    "restore": "tsx scripts/restore.ts",
    "repo:check": "node scripts/repo-check.mjs",
    "validate:content": "tsx scripts/validate-content.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.83",
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.8",
    "ai": "7.0.161",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/cli": "0.1.23",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "concurrently": "9.2.5",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
